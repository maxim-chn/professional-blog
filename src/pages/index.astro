---
import { getCollection } from 'astro:content';
import PostCatalogue from '@components/PostCatalogue.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import {
  loadCataloguePage,
  type CataloguePage,
} from '../lib/server/catalogue.ts';
import { createErrorResponse } from '../lib/server/http-errors.ts';
import type { RuntimePersistence } from '../lib/server/persistence.ts';
import { buildPlaygroundUrl } from '../lib/server/playground-url.ts';
import { loadRuntime } from '../lib/server/runtime.ts';

export const prerender = false;

let runtime: RuntimePersistence;
try {
  runtime = await loadRuntime();
} catch (error) {
  return createErrorResponse(error, 'configuration');
}

let catalogue: CataloguePage;
try {
  catalogue = await loadCataloguePage(
    runtime.service,
    runtime.cataloguePageSize,
    runtime.visitorOrigin,
    new URLSearchParams(),
  );
} catch (error) {
  return createErrorResponse(error, 'request');
}

const playgrounds = await getCollection(
  'playground',
  ({ data }) => !data.draft,
);
---

<BaseLayout
  title="Professional Blog"
  description="Engineering notes, small software projects, and executable artifacts."
>
  <section class="intro">
    <p>Personal engineering blog</p>
    <h1>Notes, experiments, and runnable software artifacts.</h1>
  </section>

  <PostCatalogue catalogue={catalogue} />

  <section
    id="playground"
    class="playground-list"
    aria-labelledby="playground-title"
  >
    <h2 id="playground-title">Playground</h2>
    <ul>
      {
        playgrounds.map((playground) => (
          <li>
            <a href={buildPlaygroundUrl(runtime.visitorOrigin, playground.id)}>
              {playground.data.title}
            </a>
            <p>{playground.data.description}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .intro {
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2rem;
    padding-bottom: 2rem;
  }

  .intro p {
    color: var(--color-accent);
    font-weight: 700;
    margin: 0 0 0.75rem;
    text-transform: uppercase;
  }

  .intro h1 {
    font-size: clamp(2.3rem, 7vw, 4.5rem);
    line-height: 0.98;
    margin: 0;
    max-width: 12ch;
  }

  .playground-list {
    border-top: 1px solid var(--color-border);
    margin-top: 2rem;
    padding-top: 1.5rem;
  }
</style>
