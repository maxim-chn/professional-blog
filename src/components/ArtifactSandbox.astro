---
type Props = {
  src: string;
  title: string;
  height?: number;
};

const { src, title, height = 420 } = Astro.props;
---

<section class="artifact-boundary" aria-label={`Executable artifact: ${title}`}>
  <div class="artifact-boundary__header">
    <h2>{title}</h2>
    <a href={src} target="_blank" rel="noreferrer">Open artifact</a>
  </div>
  <iframe
    class="artifact-boundary__frame"
    src={src}
    title={title}
    sandbox="allow-scripts"
    loading="lazy"
    style={`height: ${height}px`}></iframe>
</section>

<style>
  .artifact-boundary {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    margin: 2rem 0;
    overflow: hidden;
    background: var(--color-surface);
  }

  .artifact-boundary__header {
    align-items: center;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    padding: 0.75rem 1rem;
  }

  .artifact-boundary__header h2 {
    font-size: 1rem;
    line-height: 1.3;
    margin: 0;
  }

  .artifact-boundary__header a {
    color: var(--color-link);
    flex: 0 0 auto;
    font-size: 0.9rem;
  }

  .artifact-boundary__frame {
    border: 0;
    display: block;
    width: 100%;
  }
</style>
