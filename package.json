{
  "name": "professional-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_RUNTIME_CONFIG=\"$PWD/config/astro-runtime.json\" ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "quality": "npm run format:check && npm run lint && npm run check && npm run build && npm run test:persistence && npm run test:runtime",
    "preview": "ASTRO_RUNTIME_CONFIG=\"$PWD/config/astro-runtime.json\" ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "start": "ASTRO_RUNTIME_CONFIG=\"$PWD/config/astro-runtime.json\" node ./dist/server/entry.mjs",
    "publish:post": "node --experimental-strip-types scripts/publish-post.ts",
    "test:runtime": "node --experimental-strip-types --test tests/runtime/*.test.ts",
    "test:persistence": "node --experimental-strip-types --test tests/persistence/*.test.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.4",
    "@astrojs/mdx": "7.0.8",
    "@astrojs/node": "11.1.4",
    "astro": "7.2.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^1.5.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
